//********* Options for Custom Build step ************
//for vertex program
//"E:\Program Files\NVIDIA Corporation\Cg\bin\cgc.exe"  -profile vp20 -posinv -o $(InputName).txt $(InputPath)
//for fragment program
//"E:\Program Files\NVIDIA Corporation\Cg\bin\cgc.exe"  -profile fp20 -o $(InputName).txt $(InputPath)
//****************************************************

//****************************************************
//Fragment shader for support Shadow map in Horizontal Grass 
//****************************************************

//Attention: define BoundTemplate for handling bounding grass blocks
//Attention: now - without Fog

//#define FULL
//#define BoundTemplate
//#define COMPAREZ  //used for Radeon

struct VertexOut
{
    //Attention: below is output from vertex shader
//    float4 HPOS : POSITION;
	fixed4 COL0 : COLOR0;
    half2 TEX0 : TEXCOORD0;    //horizontal grass texture
    half2 TEX1 : TEXCOORD1;    //land texture
	//Attention: we assume that will be used hardware shadow map support, so Tex(s/q, t/q) will be compared with r/q
#ifdef FULL
    half4 TEX2 : TEXCOORD2;    //shadow map texture    
#endif //FULL

#ifdef BoundTemplate
    half2 TEX3 : TEXCOORD3;    //template mask texture for boundary grass blocks
#endif
};


half4 main(VertexOut IN,
			uniform half4 Ka, //Ambient color
			uniform half4 Kd, //Diffuse color
            uniform sampler2D HGrassTex : TEXUNIT0,
            uniform sampler2D LandTex : TEXUNIT1
#ifdef FULL
            ,uniform sampler2D ShadowMap : TEXUNIT2
#endif //FULL

#ifdef BoundTemplate
            ,uniform sampler2D TemplateTex : TEXUNIT3
#endif
			) : COLOR
{
  half4 color;
  fixed4 diffuse_light;

//fixed4 Ka = half4(0.5, 0.5, 0.6, 0.0);    //???
//fixed4 Kd = half4(0.5, 0.5, 0.5, 0.0);    //???

  fixed4 tex0 = tex2D(HGrassTex, IN.TEX0.xy);
  fixed4 ColorStage0 = tex0 * IN.COL0;
  fixed4 tex1 = tex2D(LandTex, IN.TEX1.xy);
  fixed4 ColorStage1;
  ColorStage1.rgb = (tex1.rgb * ColorStage0.rgb) * 2.0f;  //*2.0 - ???
  ColorStage1.a = ColorStage0.a;

  color = ColorStage1;

  diffuse_light.rgb = tex1.a * Kd.rgb;   

  //template
#ifdef BoundTemplate
  fixed4 tex3 = tex2D(TemplateTex, IN.TEX3.xy);
  color.a *= tex3.a;
#endif

#ifdef FULL
  //shadow vizualization 
  fixed4 Shadow = tex2Dproj(ShadowMap, IN.TEX2.xyzw);
  fixed ShadowFactor = 0;

#ifndef COMPAREZ  
	ShadowFactor = Shadow.r;   //0 or 1
#else  //COMPAREZ
	float zProj = IN.TEX2.z/IN.TEX2.w;
	ShadowFactor = (zProj > Shadow.r)?0:1;
	ShadowFactor = (Shadow.r>0)?ShadowFactor:1;
#endif //COMPAREZ

  diffuse_light.rgb = ShadowFactor * diffuse_light.rgb;
#endif //FULL

#ifdef PROFILE_FP20
	color.rgb = saturate(Ka.rgb + diffuse_light.rgb) * color.rgb;
#else
	color.rgb = clamp(Ka.rgb + diffuse_light.rgb, 0.0, 1.0) * color.rgb;
#endif

//--------------------------
/*
  //shadow
  fixed ShadowAtt = 0.6; //0.5; //0.6; //0.5;
  ShadowFactor = lerp(ShadowFactor,1.0,ShadowAtt);   //ShadowFactor = ShadowFactor*(1.0-ShadowAtt) + ShadowAtt;  
  color.rgb *= ShadowFactor;
*/
//--------------------------

  //fog (add secondary color)
//???????????????


  return color;
}



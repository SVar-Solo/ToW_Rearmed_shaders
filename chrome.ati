// ATI fragment shader, specification example:

// pass 1
r1 = pass(tex1.str);
r2 = pass(tex2.str);
r3 = pass(tex3.str);
r4 = sample(tex4.str);

r4 = dot3(r1, 2*(r4-0.5));
r1 = dot3(r1,r3);
r1.g = dot3(r3,r3);

//pass 2
r0 = sample(tex5.str_dr);
r2 = sample(r2.str);
r3 = sample(r1.str);
r4 = pass(r4.str);

r3 = r3*r4;
r3 = r0*r3;
r4 = r0*r4;
r0 = r3*r4;
r0 = saturate(r0*r2.r);
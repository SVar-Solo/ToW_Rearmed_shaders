//Road pixel shader.
//This is ARB version of shader (also used as fp20 version in case of SPECULAR macros not defined)
//So on GeForce3,4 will be used truncated version without specular

//#define SPECULAR  //used only for ARB profile
//#define SHADOW 
//#define COMPAREZ  //used only for ARB profile (for Radeon)
#define PSSM

struct VertexOut
{	
  float2 TexCoord0 : TEXCOORD0;  //Road texture
  float2 TexCoord1 : TEXCOORD1;  //Bump map           //really duplicate TexCoord0 - need for fp20 profile only
  float4 Color : COLOR0;        //Color.r contain Land.a, Color.g contain vertex Alpha

#ifdef SHADOW 
  float4 TexCoord2 : TEXCOORD2;  //Shadow map
#endif  //SHADOW

#ifdef SPECULAR
  float3 Color1 : COLOR1;       //Normal here for specular
  float3 tex3 : TEXCOORD3;      //contain Half vector for given vertex (need for specular)
#endif //SPECULAR
  float4 fogCoord: TEXCOORD4;
  float2 megaCoord: TEXCOORD5;
};

//-----------------------------------------------------------------------------
//	getPSSMPixel3
//-----------------------------------------------------------------------------

#ifdef SHADOW
	uniform sampler2D ShadowMap : TEXUNIT2;
#endif  //SHADOW

#ifdef PSSM
// PSSM implemetation
// matrix array
uniform float4x4 PSSMProjTexMatrix0;
uniform float4x4 PSSMProjTexMatrix1;
uniform float4x4 PSSMProjTexMatrix2;
uniform float4x4 PSSMProjTexMatrix3;

uniform float PSSMSplit0;
uniform float PSSMSplit1;
uniform float PSSMSplit2;
uniform float PSSMSplit3;

uniform float PSSMWidth;

uniform float3 koeffNdotL;

uniform float fSkyMultiplier;

float getPSSMPixel3 (float4 world_coords)
{
    float4 shad_coord;
	float4 shadow_sample;

	// 0 level	
	float4 shad_coord0 = mul(PSSMProjTexMatrix0, float4(world_coords.xyz, 1));
	float4 shad_coord1 = mul(PSSMProjTexMatrix1, float4(world_coords.xyz, 1));
	float4 shad_coord2 = mul(PSSMProjTexMatrix2, float4(world_coords.xyz, 1));
	float4 shad_coord3 = mul(PSSMProjTexMatrix3, float4(world_coords.xyz, 1));

	float4 sm_k;
	
	if (shad_coord0.x > 0.0 && shad_coord0.x < 1.0 && shad_coord0.y > 0.0 && shad_coord0.y < 1.0)
	{
		sm_k.x = 1.0; // float4 (1.0, 0.0, 0.0, 0.0);
	}
	else
	{
		sm_k.x = 0.0;
		if (shad_coord1.x > 0.0 && shad_coord1.x < 1.0 && shad_coord1.y > 0.0 && shad_coord1.y < 1.0)
		{
			sm_k.y = 1.0;
		}
		else
		{
			sm_k.y = 0.0;
			if (shad_coord2.x > 0.0 && shad_coord2.x < 1.0 && shad_coord2.y > 0.0 && shad_coord2.y < 1.0)
			{
				sm_k.z = 1.0;
			}
			else
			{
				// sm_k.w = 1.0;
				if (shad_coord3.x > 0.0 && shad_coord3.x < 1.0 && shad_coord3.y > 0.0 && shad_coord3.y < 1.0)
				{
					sm_k.w = 1.0;
				}
				else
				{
					return 1;
				}
			}
		}
		
	}

	//float sm_k_none = 1 - (dot(sm_k, sm_k));
	
	shad_coord = 
		sm_k.x*shad_coord0 + 
		sm_k.y*shad_coord1 + 
		sm_k.z*shad_coord2 + 
		sm_k.w*shad_coord3;

	//shad_coord = mul(sh_m, float4(world_coords.xyz, 1));

	shad_coord.xyz /= shad_coord.w;

	float2 sm_offs = sm_k.x*float2(0, 0.5) +
		sm_k.y*float2(0.5, 0.5) + 
		sm_k.z*float2(0, 0) + 
		sm_k.w*float2(0.5, 0);

	float2 sm_scale = sm_k.x*0.8 + sm_k.y*0.6 + sm_k.z*0.4 + sm_k.w*0.2;

	shadow_sample = tex2D(ShadowMap, float2(sm_offs.x + 0.5*shad_coord.x, sm_offs.y + 0.5*shad_coord.y));

	float shadow_factor = 1.0;

#ifndef COMPAREZ  
	shadow_factor = shadow_sample.r;   // 0 or 1
#else  //COMPAREZ
	shadow_factor = (shad_coord.z > shadow_sample.r) ? 0 : 1;
	shadow_factor = shadow_sample.r > 0 ? shadow_factor : 1;
#endif //COMPAREZ
	
	//return sm_scale*shadow_factor;
	return shadow_factor; //  + sm_k_none;
}

#endif // PSSM

float4 main(in VertexOut IN, 
			uniform float4 Ka, //Ambient color
			uniform float4 Kd, //Diffuse color
			uniform float3 LightDir,                           //Dir to sun
			uniform sampler2D RoadTex: TEXUNIT0,              //Road texture
            uniform sampler2D BumpMap : TEXUNIT1              //Bump texture

#ifdef SPECULAR
	       ,uniform float SpecularAmount                     //degree of specular - 16.0  ???????????????
	       ,uniform float BumpAmount                         //influnce of bump normal to specular - 1.0  ???????????????
	       ,uniform float3 SunSpecularColor
#endif //SPECULAR

#ifdef FOG
			,uniform samplerCUBE SkyMap: TEXUNIT3 // Fog texture
#endif
			,uniform sampler2D MegaNormalMap : TEXUNIT4              //Bump texture
			) : COLOR
{
    //read bump vector
	float4 Bump = tex2D(BumpMap, IN.TexCoord1);
	Bump.rgb = 2.0f*(Bump.rgb-0.5f);  //blue component after this conversion will be the same

	// Global landspace normal as basis for bump
	float4 MegaNormalColor = tex2D(MegaNormalMap, float2(IN.megaCoord.x, 1-IN.megaCoord.y));

	float3 MegaNormal = 2*float3(MegaNormalColor.a, 1-MegaNormalColor.g, 0)-1;
	float sx = MegaNormal.x;
	float sy = MegaNormal.y;
	float sz = sqrt(1.0f-(sx*sx+sy*sy));
	MegaNormal = normalize(float3(sx, sy, sz));

	float3 Nx = float3(MegaNormal.z, 0, -MegaNormal.x);
	float3 Ny = float3(0, MegaNormal.z, -MegaNormal.y);
	Bump.xyz = normalize(Bump.z * MegaNormal.xyz + Bump.x * Nx + Bump.y * Ny);

	//Bump.xyz = MegaNormal.xyz;

    //---diffuse---
	float LandA = IN.Color.z;
	float3 diffuse_light;       //Attention: under arbfp1 and fp30 profile I have a compilation error if use float4 instead of float3 (?????)
    diffuse_light.rgb = (Kd).rgb;
	float scalar_product = dot(Bump.rgb, LightDir) * LandA;
	//diffuse_light.rgb *= scalar_product;

#ifdef SPECULAR
	//---specular---
	float3 specular_light = SunSpecularColor;
    float3 normal = 2.0*(IN.Color1-0.5);
    float3 Norm = normalize(lerp(normal.rgb, Bump.rgb, BumpAmount));
	float3 HalfVec = normalize(IN.tex3);
    float spec = dot(HalfVec, Norm);
    spec = pow(spec,SpecularAmount);

	float gloss = Bump.a;
	specular_light = specular_light * spec * gloss;
	//--------------
#endif //SPECULAR

	float4 Road = tex2D(RoadTex, IN.TexCoord0);   
	float4 NewRoadTex = tex2D(RoadTex, IN.TexCoord0);

	// shadow
#ifdef SHADOW
#ifdef PSSM
	float ShadowFactor = getPSSMPixel3(IN.TexCoord2);
	scalar_product *= ShadowFactor;
#ifdef SPECULAR
	specular_light = ShadowFactor * specular_light;
#endif //SPECULAR

#else
    //---shadows---
	float4 Shadow = float4(1,0,0,1);
    float ShadowFactor = 0;

	Shadow = tex2Dproj(ShadowMap, IN.TexCoord2.xyzw);

#ifndef COMPAREZ  
	ShadowFactor = Shadow.r;   //0 or 1
#else  //COMPAREZ
	float zProj = IN.TexCoord2.z/IN.TexCoord2.w;
	ShadowFactor = (zProj > Shadow.r)?0:1;
	ShadowFactor = (Shadow.r>0)?ShadowFactor:1;
#endif //COMPAREZ

	scalar_product *= ShadowFactor;

#ifdef SPECULAR
	specular_light = ShadowFactor * specular_light;
#endif //SPECULAR
	//-------------
#endif // PSSM
#endif  //SHADOW

	scalar_product = clamp(scalar_product * koeffNdotL.x + koeffNdotL.y , 0, 1);
	Road.rgb *= lerp(Ka.rgb, diffuse_light.rgb*koeffNdotL.z, scalar_product);
	//Road.rgb = scalar_product.xxx;

	float VertexAlpha = IN.Color.g;  //vertex alpha

#ifdef SPECULAR

#ifdef PROFILE_FP20
	Road.rgb += (saturate(specular_light) * VertexAlpha);          //also weight specular with vertex alpha
#else
	Road.rgb += ((specular_light) * VertexAlpha);   //also weight specular with vertex alpha
#endif

#endif //SPECULAR

	//update out alpha
    Road.a *= VertexAlpha;
    //Road.rgb = lerp(float3(1,1,1), Road.rgb, Road.a);
    
    //NewRoadTex.a *= VertexAlpha;
    //NewRoadTex.rgb = lerp(float3(1,1,1), NewRoadTex, VertexAlpha);

   //Road.rgb = Ka.rgb;

#ifdef FOG
  float4 fogColor = texCUBE(SkyMap, IN.fogCoord.xyz);
  fogColor.rgb = lerp(fogColor.rgb, fogColor.rgb*fSkyMultiplier, fogColor.a);
  // compute final color
  Road.rgb = lerp(Road.rgb, fogColor.rgb, IN.fogCoord.w);
#endif

    return Road; 
}



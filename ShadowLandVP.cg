//****************************************************
//Vertex shader for Fog+Shadow calculation
//Most code is the same as in FogTest.cg - for fog calculation
//Additional code contain texture coordinate calculations for shadow map (instead of calc in fixed pipeline)
//****************************************************

struct appdata
{
    float4 position : POSITION;
};

struct vfconn
{
    float4 HPOS : POSITION;
    float4 COL0 : COLOR0;
    float2 TEX0 : TEXCOORD0;    //fog texture

	//Attention: we assume that will be used hardware shadow map support, so Tex(s/q, t/q) will be compared with r/q
    float4 TEX1 : TEXCOORD1;    //shadow map texture - !!!NEW    
    float2 TEX2 : TEXCOORD2;    //land texture - !!!NEW    
};

//Calculate integral fog density throw 2 fog layers
//Attention: Note!!! A*=0.5
float IntegralHDense2(in float4 cFogHBounds,       //cMinFogH1 cMaxFogH1 cMinFogH2 cMaxFogH2
                      in float4 cFogABAB,          //xy=A1B1, zw=A2B2
                      in float H0, in float H1)    //height for camera and vertex				 
{

  float4 HH = float4(H0, H1, H0, H1);
  HH = clamp(HH, cFogHBounds.xxzz, cFogHBounds.yyww);   //here HH=(hMin1,hMax1,hMin2,hMax2)
  float4 ff = HH*(HH*cFogABAB.xxzz + cFogABAB.yyww);
  return dot(ff, float4(-1.0f, 1.0f, -1.0f, 1.0f)); 
}

vfconn main(appdata IN,

#ifndef PROFILE_ARBVP1
            uniform float4x4 ModelViewProj : _GL_MVP,
#endif
			uniform float3 CamPos,
            //helper const 
            uniform float cTexScale,       //for calc texture coordinate in texture with fog RGB color
			uniform float4 cFogHBounds,    //cMinFogH1 cMaxFogH1 cMinFogH2 cMaxFogH2
            uniform float4 cFogABAB,       //A1,B1,A2,B2

			uniform float4x4 ShadowMapProjTexMatrix,   //shadow map texture - !!!NEW
			uniform float4 S_TexGenVec,                //tex gen vector for main land texture  - !!!NEW
			uniform float4 T_TexGenVec)                //tex gen vector for main land texture  - !!!NEW
{
    vfconn OUT;

#ifdef PROFILE_ARBVP1
   float4x4 ModelViewProj = glstate.matrix.mvp;
#endif

	//---transform vertex to camera space---
    OUT.HPOS = mul(ModelViewProj, IN.position);

	//**************************************************************************
	//Attention: calculation logic must be the same, see TLandscape::GetFogRGBA()
	//**************************************************************************

    float3 dP = IN.position.xyz-CamPos;
    float dist = length(dP);

    //--main fog calculation--
  	float H0 = CamPos.z;
    float H1 = IN.position.z;
    float InvSinAlfa=dist/(H1-H0);
    float II=InvSinAlfa*IntegralHDense2(cFogHBounds, cFogABAB, H0, H1);  
    float fog=1.0-exp(-abs(II));

	//--select fog RGB color from fog support texture--   
    OUT.COL0 = float4(1.0, 1.0, 1.0, fog);  
	OUT.TEX0 = (cTexScale*dP + 0.5).xy; 


	//-----------calc OUT.TEX1 (NEW)------------	
    OUT.TEX1 = mul(ShadowMapProjTexMatrix, IN.position);
/*
    float4 texcoord = mul(ShadowMapProjTexMatrix, IN.position);
    texcoord.xyz = texcoord.xyz/texcoord.w;
    texcoord.w = 1.0;
    OUT.TEX1 = texcoord;
*/

	//here we assume that IN.position.w = 1.0
    IN.position.w = 1.0;
	float s = dot(S_TexGenVec, IN.position);  
	float t = dot(T_TexGenVec, IN.position);
    OUT.TEX2 = float2(s,t);
	//------------------------------------------

    return OUT;
} 

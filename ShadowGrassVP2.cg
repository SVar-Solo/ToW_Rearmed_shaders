//****************************************************
//Vertex shader for Shadow calculation for Horizontal Grass
//****************************************************

//Attention: define BoundTemplate for handling bounding grass blocks
//Attention: now - without Fog

//#define FULL
//#define BoundTemplate

struct VertexIN
{
    float4 position : POSITION;
#ifdef BoundTemplate
    float2 TEX3 : TEXCOORD3;     
#endif //BoundTemplate
};

struct VertexOUT
{
    float4 HPOS : POSITION;
	float4 COL0 : COLOR0;
    float2 TEX0 : TEXCOORD0;    //horizontal grass texture
    float2 TEX1 : TEXCOORD1;    //land texture
	//Attention: we assume that will be used hardware shadow map support, so Tex(s/q, t/q) will be compared with r/q
#ifdef FULL
    float4 TEX2 : TEXCOORD2;    //shadow map texture  
#endif  //FULL	

#ifdef BoundTemplate
    float2 TEX3 : TEXCOORD3;    //template mask texture for boundary grass blocks
#endif  //BoundTemplate
};

VertexOUT main(VertexIN IN,

#ifndef PROFILE_ARBVP1
            uniform float4x4 ModelViewProj,
#endif

#ifdef FULL
			uniform float4x4 ShadowMapProjTexMatrix,
#endif //FULL

			uniform float4 LayerColor,
			uniform float LayerDH,
			uniform float4 S_TexGenVec,                //tex gen vector for main land texture
			uniform float4 T_TexGenVec                 //tex gen vector for main land texture
			)                
{
    VertexOUT OUT;

#ifdef PROFILE_ARBVP1
   float4x4 ModelViewProj = glstate.matrix.mvp;
#endif

	//---transform vertex to camera space---
    float4 new_position = IN.position;
    new_position.z += LayerDH;
    OUT.HPOS = mul(ModelViewProj, new_position);
	//------------------------------------------

    OUT.COL0 = LayerColor;

    OUT.TEX0 = 0.5 * IN.position.xy;

	float s = dot(S_TexGenVec, IN.position);  
	float t = dot(T_TexGenVec, IN.position);
    OUT.TEX1 = float2(s,t);

	//-----------calc OUT.TEX2 (NEW)------------	
#ifdef FULL
    OUT.TEX2 = mul(ShadowMapProjTexMatrix, new_position);
#endif  //FULL

#ifdef BoundTemplate
    OUT.TEX3 = IN.TEX3;
#endif

    return OUT;
} 

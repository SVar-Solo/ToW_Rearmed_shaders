float getBilinearFilteredShadowPixel(float3 uvz)
{
  float mgs = 1024.f;
  uvz.x *= mgs;
  uvz.y *= mgs;
  float x = floor(uvz.x);
  float y = floor(uvz.y);
  float z = uvz.z * mgs;
  float u_ratio = uvz.x - x;
  float v_ratio = uvz.y - y;
  float u_opposite = 1 - u_ratio;
  float v_opposite = 1 - v_ratio;
  float result = (getShadowPixel(float3(x,y,z)/mgs) * u_opposite  + getShadowPixel(float3(x+1,y,z)/mgs) * u_ratio) * v_opposite + 
                  (getShadowPixel(float3(x,y+1,z)/mgs) * u_opposite  + getShadowPixel(float3(x+1,y+1,z)/mgs) * u_ratio) * v_ratio;
  return result;
}

float4 getMegaNumberPixel(float2 coord)
{
	float mgSize = 128*256;//MGT_TILE_SIZE.x;
	float tileSize = 256;//MGT_TILE_SIZE.y;
	float scaleDSDT = 4.0f/mgSize;
	float tablesize = 8;
	float4 DsDtLookup = 2*tex2D(maskDSDT, 128*coord.xy)-1;
	float2 newst = float2(coord.x + scaleDSDT * DsDtLookup.x, coord.y + scaleDSDT * DsDtLookup.y);
	float4 col = tex2D(typeMap, newst);
	float lod = round(col.r*255);
	float tileY = floor(lod/tablesize);
	float tileX = lod - tileY*tablesize;
	float2 tileUV = float2(tileX, tileY);
	float2 offsetUV = frac(coord * (mgSize / tileSize));
	float2 megaUV = (tileUV+offsetUV)/tablesize;
	col.rgb = tex2D(megaNoise, megaUV).rgb;
	return col;
}

float4 getBilinearFilteredMegaNoise(float2 uv)
{

  //float4 col = tex2D(IndirTex, uv);
  //float lod = floor(col.a*255);
  //float mgs = MGT_TILE_SIZE.x/pow(2,lod);
  float mgs = 128*256;

  uv.x *= mgs;
  uv.y *= mgs;
  float x = floor(uv.x);
  float y = floor(uv.y);
  float u_ratio = uv.x - x;
  float v_ratio = uv.y - y;
  float u_opposite = 1 - u_ratio;
  float v_opposite = 1 - v_ratio;
  float4 result = (getMegaNumberPixel(float2(x,y)/mgs) * u_opposite  + getMegaNumberPixel(float2(x+1,y)/mgs) * u_ratio) * v_opposite + 
                  (getMegaNumberPixel(float2(x,y+1)/mgs) * u_opposite  + getMegaNumberPixel(float2(x+1,y+1)/mgs) * u_ratio) * v_ratio;
  return result;
}

float4 getMegaPixel(float2 coord)
{
	float mgSize = MGT_TILE_SIZE.x;
	float tileSize = MGT_TILE_SIZE.y;
	float tileCount = MGT_TILE_SIZE.z;
	float cache_sidesize = 64;
	float4 col = tex2D(IndirTex, float2(coord.x, coord.y));
	float lod = (col.a*255);
	float tileY = (col.g*255);
	float tileX = (col.r*255);
	float2 tileUV = float2(round(tileX), round(tileY));
	float2 offsetUV = frac(coord * tileCount / pow(2,lod) );
	float2 megaUV = (tileUV+offsetUV)/cache_sidesize;
	float4 pix = tex2D(MegaCacheTex, megaUV);
	return pix;
}

float4 getBilinearFilteredMegaPixel(float2 uv)
{
  float mgs = MGT_TILE_SIZE.x;

  uv.x *= mgs;
  uv.y *= mgs;
  float x = floor(uv.x);
  float y = floor(uv.y);
  float u_ratio = uv.x - x;
  float v_ratio = uv.y - y;
  float u_opposite = 1 - u_ratio;
  float v_opposite = 1 - v_ratio;

  float4 result = (getMegaPixel(float2(x,y)/mgs) * u_opposite  + getMegaPixel(float2(x+1,y)/mgs) * u_ratio) * v_opposite + 
                  (getMegaPixel(float2(x,y+1)/mgs) * u_opposite  + getMegaPixel(float2(x+1,y+1)/mgs) * u_ratio) * v_ratio;
  return result;
}

float4 main(in VertexOUT IN // From vertex shader
	,uniform float3 SunDiffuse
	,uniform float3 SunAmbient
#ifdef CLIPPING
	,uniform float fClipPlaneZ
#endif
	   ) : COLOR
{
	float4 result;
	
#ifdef CLIPPING
	if (IN.coord.z<fClipPlaneZ)
		discard;
#endif
	//result =  getMegaPixel(IN.coord.xy);
	result =  getBilinearFilteredMegaPixel(IN.coord.xy);
	//float4 CommonNoisePixel = float4(IN.coord.xy*commonNoiseTile, 0, 0);//tex2D(CommonNoise, IN.coord.xy*commonNoiseTile);
	float4 CommonNoisePixel = tex2D(CommonNoise, IN.coord.xy*commonNoiseTile);
	result.rgb *= CommonNoisePixel.rgb*2;
	float ndl = result.a;//clamp(result.a, 0, 1);
	float4 TMColor = tex2D(typeMap, IN.coord.xy);
	result.a = TMColor.a;
#ifdef USE_BUMP
/*
	float3 normPixel = tex2D(NormalMap, float2(IN.coord.x, 1-IN.coord.y)).rgb;
	normPixel = float3(normPixel.r,1-normPixel.g,normPixel.b);
	float3 normal = (2*normPixel-1);
	//float sx = normal.x;
	//float sy = normal.y;
	//float sz = sqrt(1.0f-(sx*sx+sy*sy))/4;
	//normal = normalize(float3(sx, sy, sz));
*/
	float4 normPixel = tex2D(NormalMap, float2(IN.coord.x, 1-IN.coord.y));
	float3 normal = 2*float3(normPixel.a, 1-normPixel.g, 0)-1;
	float sx = normal.x;
	float sy = normal.y;
	float sz = sqrt(1.0f-(sx*sx+sy*sy));
	normal = normalize(float3(sx, sy, sz));
	ndl *= saturate(dot(SunDir, normal));
#endif

#ifdef SHADOW

#ifdef PSSM
	float ShadowFactor = getPSSMPixel3(IN.worldCoord);
#else
	float3 projcoord = IN.shadCoord.xyz/IN.shadCoord.w;

	#ifdef SM30
		float ShadowFactor = getBilinearFilteredShadowPixel(projcoord);
	#else
		float ShadowFactor = getShadowPixel(projcoord);
	#endif
#endif // PSSM
    
    ndl *= ShadowFactor;
#endif  //SHADOW

	//result.rgb *= (ndl*(SunDiffuse+SunAmbient)+SunAmbient);
	ndl = clamp(ndl*koeffNdotL.x + koeffNdotL.y, 0, 1);
	result.rgb *= lerp(SunAmbient, (SunDiffuse*koeffNdotL.z), ndl);
#ifdef USE_NOISE
	float R1 = 10.f;
	float R2 = 400.f;
#ifdef SM30
	result.rgb = lerp(result.rgb*getBilinearFilteredMegaNoise(IN.coord.xy).rgb*2, result.rgb, clamp((IN.spos.z-R1)/(R2-R1),0,1));
#else
	result.rgb = lerp(result.rgb*getMegaNumberPixel(IN.coord.xy).rgb*2, result.rgb, clamp((IN.spos.z-R1)/(R2-R1),0,1));
#endif
#endif

#ifdef USE_FOG
  float4 fogColor = texCUBE(SkyMap, IN.fogCoord);
  fogColor.rgb = lerp(fogColor.rgb, fogColor.rgb*fSkyMultiplier, fogColor.a);
  // compute final color
  //result.rgb = fogColor.rgb;//lerp(result.rgb, fogColor.rgb, IN.FogColor.a);
  result.rgb = lerp(result.rgb, fogColor.rgb, IN.FogColor.a);
  //result.rgb = float3(IN.fogCoord.xy,0);
#endif
#ifdef USE_BUMP
	//result.rgb = normal.rgb;
#endif
	return result;			
}
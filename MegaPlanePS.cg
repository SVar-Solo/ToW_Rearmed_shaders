// defines
#define PSSM 1

// From vertex shader
struct VertexOUT
{
#ifdef USE_FOG
	float4 FogColor: COLOR0;
#endif
	float3 coord : TEXCOORD0;
	float4 spos : TEXCOORD1;
#ifdef SHADOW
  #ifdef PSSM
	float4 worldCoord : TEXCOORD2;
  #else
	float4 shadCoord : TEXCOORD2;
  #endif	
  #ifdef USE_FOG
	float3 fogCoord : TEXCOORD3;
  #endif
#else
  #ifdef USE_FOG
	float3 fogCoord : TEXCOORD2;
  #endif
#endif
};
uniform sampler2D IndirTex: TEXUNIT0; // Base texture
uniform sampler2D MegaCacheTex: TEXUNIT1; // Base texture
uniform float3 MGT_TILE_SIZE; // MegaTexSize + TileSize + (MegaTexSize / TileSize)
#ifdef SHADOW
      uniform sampler2D ShadowMap : TEXUNIT2;           //shadow map
#endif  //SHADOW
uniform sampler2D typeMap: TEXUNIT3; 
uniform sampler2D megaNoise: TEXUNIT4;
uniform sampler2D maskDSDT: TEXUNIT5;
#ifdef USE_FOG
uniform samplerCUBE SkyMap: TEXUNIT6; // Fog texture
#endif
uniform sampler2D NormalMap: TEXUNIT7; // bump texture
uniform float3 SunDir;
uniform sampler2D CommonNoise: TEXUNIT8; // bump texture
uniform float commonNoiseTile;
uniform float3 koeffNdotL;
uniform float fSkyMultiplier;

//-----------------------------------------------------------------------------
// PSSM
//-----------------------------------------------------------------------------

// matrix array
uniform float4x4 PSSMProjTexMatrix0;
uniform float4x4 PSSMProjTexMatrix1;
uniform float4x4 PSSMProjTexMatrix2;
uniform float4x4 PSSMProjTexMatrix3;

uniform float PSSMSplit0;
uniform float PSSMSplit1;
uniform float PSSMSplit2;
uniform float PSSMSplit3;

uniform float PSSMWidth;

// sample shadow map
float getShadowPixel(float3 projcoord)
{
    float ShadowFactor = 1;
#ifdef SHADOW
	float4 Shadow = tex2D(ShadowMap, projcoord.xy);
#ifndef COMPAREZ  
	ShadowFactor = Shadow.r;   //0 or 1
#else  //COMPAREZ
	float zProj = projcoord.z;
	ShadowFactor = (zProj > Shadow.r)?0:1;
	ShadowFactor = Shadow.r>0?ShadowFactor:1;
#endif //COMPAREZ
#endif  //SHADOW
	return ShadowFactor;
}

float getPSSMPixel2 (float4 world_coords)
{
    float4 shad_coord;
	float4 shadow_sample;

	// 0 level	
	//float4 shad_coord0 = mul(PSSMProjTexMatrix0, float4(world_coords.xyz, 1));
	//float4 shad_coord1 = mul(PSSMProjTexMatrix1, float4(world_coords.xyz, 1));
	//float4 shad_coord2 = mul(PSSMProjTexMatrix2, float4(world_coords.xyz, 1));
	//float4 shad_coord3 = mul(PSSMProjTexMatrix3, float4(world_coords.xyz, 1));

	float4 sm_k;
	

	//sm_k.x = step(0, world_coords.w) - step(10, world_coords.w);
	//sm_k.y = step(10, world_coords.w) - step(50, world_coords.w);
	//sm_k.z = step(50, world_coords.w) - step(220, world_coords.w);
	//sm_k.w = step(220, world_coords.w) - step(1200, world_coords.w);

	sm_k.x = world_coords.w > 0 ? (world_coords.w < PSSMSplit0 ? 1.0 : 0.0) : 0.0;
	sm_k.y = world_coords.w > PSSMSplit0 ? (world_coords.w < PSSMSplit1 ? 1.0 : 0.0) : 0.0;
	sm_k.z = world_coords.w > PSSMSplit1 ? (world_coords.w < PSSMSplit2 ? 1.0 : 0.0) : 0.0;
	sm_k.w = world_coords.w > PSSMSplit2 ? (world_coords.w < PSSMSplit3 ? 1.0 : 0.0) : 0.0;

	float sm_k_none = 1 - (dot(sm_k, sm_k)); // step(PSSMSplit3, world_coords.w); //  ? 1 : 0;

	float4x4 sh_m = sm_k.x*PSSMProjTexMatrix0 +
					sm_k.y*PSSMProjTexMatrix1 + 
					sm_k.z*PSSMProjTexMatrix2 + 
					sm_k.w*PSSMProjTexMatrix3;

	//shad_coord = sm_k.x*shad_coord0 + sm_k.y*shad_coord1 + sm_k.z*shad_coord2 + 
	//	sm_k.w*shad_coord3;
	shad_coord = mul(sh_m, float4(world_coords.xyz, 1));

	shad_coord.xyz /= shad_coord.w;

	float3 sm_offs =	sm_k.x * float3(0.0, 0.5, 0.0) +
						sm_k.y * float3(0.5, 0.5, 0.0) + 
						sm_k.z * float3(0.0, 0.0, 0.0) + 
						sm_k.w * float3(0.5, 0.0, 0.0);

	//float2 sm_scale = sm_k.x*0.8 + sm_k.y*0.6 + sm_k.z*0.4 + sm_k.w*0.2;

	float shadow_factor = 1.0;

	//if (0)
	//{
	//	return 1;
	//}
	//else if (0)
	//{
	//	//shadow_sample = tex2D(ShadowMap, float2(sm_offs.x + 0.5*shad_coord.x, sm_offs.y + 0.5*shad_coord.y));
	//	shadow_factor = getShadowPixel(sm_offs + float3(0.5*shad_coord.xy, shad_coord.z));
	//}
	//else
	{
		float3 uvz = shad_coord.xyz; // clamp(shad_coord.xy, 0.0, 1.0);
		uvz.xy = clamp(shad_coord.xy, 0.0, 1.0); 
		float mgs = PSSMWidth;
		uvz.x *= 0.5*PSSMWidth;
		uvz.y *= 0.5*PSSMWidth;
		float x = floor(uvz.x);
		float y = floor(uvz.y);
		float z = uvz.z * mgs;
		float u_ratio = uvz.x - x;
		float v_ratio = uvz.y - y;
		float u_opposite = 1 - u_ratio;
		float v_opposite = 1 - v_ratio;

		//shadow_sample = tex2D(ShadowMap, float2(sm_offs.x + 0.5*shad_coord.x, sm_offs.y + 0.5*shad_coord.y));

		shadow_factor =
			(getShadowPixel(sm_offs + float3(x, y, z)/mgs)*u_opposite + 
			 getShadowPixel(sm_offs + float3(x+1,y,z)/mgs)*u_ratio) * v_opposite + 

			(getShadowPixel(sm_offs + float3(x,y+1,z)/mgs) * u_opposite + 
			 getShadowPixel(sm_offs + float3(x+1,y+1,z)/mgs)*u_ratio) * v_ratio;
	}
	
	//return sm_scale*shadow_factor;
	return shadow_factor; //  + sm_k_none;
}

float getPSSMPixel3 (float4 world_coords)
{
    float4 shad_coord;
	float4 shadow_sample;

	// 0 level	
	float4 shad_coord0 = mul(PSSMProjTexMatrix0, float4(world_coords.xyz, 1));
	float4 shad_coord1 = mul(PSSMProjTexMatrix1, float4(world_coords.xyz, 1));
	float4 shad_coord2 = mul(PSSMProjTexMatrix2, float4(world_coords.xyz, 1));
	float4 shad_coord3 = mul(PSSMProjTexMatrix3, float4(world_coords.xyz, 1));

	float4 sm_k; // = float4(0, 0, 0, 1);
	
	if (shad_coord0.x > 0.0 && shad_coord0.x < 1.0 && shad_coord0.y > 0.0 && shad_coord0.y < 1.0)
	{
		sm_k.x = 1.0; // float4 (1.0, 0.0, 0.0, 0.0);
	}
	else
	{
		sm_k.x = 0.0;
		if (shad_coord1.x > 0.0 && shad_coord1.x < 1.0 && shad_coord1.y > 0.0 && shad_coord1.y < 1.0)
		{
			sm_k.y = 1.0;
		}
		else
		{
			sm_k.y = 0.0;
			if (shad_coord2.x > 0.0 && shad_coord2.x < 1.0 && shad_coord2.y > 0.0 && shad_coord2.y < 1.0)
			{
				sm_k.z = 1.0;
			}
			else
			{
				sm_k.w = 1.0;
				if (shad_coord3.x > 0.0 && shad_coord3.x < 1.0 && shad_coord3.y > 0.0 && shad_coord3.y < 1.0)
				{
					sm_k.w = 1.0;
				}
				else
				{
					return 1;
					//sm_k.w = 0.0;
				}
			}
		}
	}
	//sm_k.x = step(0, world_coords.w) - step(10, world_coords.w);
	//sm_k.y = step(10, world_coords.w) - step(50, world_coords.w);
	//sm_k.z = step(50, world_coords.w) - step(220, world_coords.w);
	//sm_k.w = step(220, world_coords.w) - step(1200, world_coords.w);

	//sm_k.x = (shad_coord0.x > 0.0 && shad_coord0.x < 1.0 && shad_coord0.y > 0.0 && shad_coord0.y < 1.0) ? 1.0 : 0.0;	
	//sm_k.y = (sm_k.x < 1 && shad_coord1.x > 0.0 && shad_coord1.x < 1.0 && shad_coord1.y > 0.0 && shad_coord1.y < 1.0) ? 1.0 : 0.0;
	//sm_k.y = sm_k.x > 0 ? 0.0 : sm_k.y;
	//sm_k.z = (sm_k.y < 1 && shad_coord2.x > 0.0 && shad_coord2.x < 1.0 && shad_coord2.y > 0.0 && shad_coord2.y < 1.0) ? 1.0 : 0.0;
	//sm_k.z = sm_k.y > 0 ? 0.0 : sm_k.z;

	//sm_k.y =(shad_coord1.xy > float2(0.0, 0.0) && shad_coord1.xy < float2(1.0, 1.0) ? 1.0 : 0.0);
	

	//sm_k.z = (shad_coord2.xy > float2(0.0, 0.0) && shad_coord2.xy < float2(1.0, 1.0) ? 1.0 : 0.0);
	//sm_k.z = sm_k.y > 0 ? 0.0 : sm_k.z;

	//sm_k.w = (shad_coord3.xy > float2(0.0, 0.0) && shad_coord3.xy < float2(1.0, 1.0) ? 1.0 : 0.0);
	//sm_k.w = sm_k.z > 0 ? 0.0 : sm_k.w;

	//sm_k = float4 (1, 0, 0, 0);


	//float sm_k_none = 1 - (dot(sm_k, sm_k));
	
	//sm_k.y = shad_coord1.xy > float2(0.0, 0.0) ? shad_coord1.xy < float2(1.0, 1.0) ? 1.0 : 0.0;
	//sm_k.z = shad_coord2.xy > float2(0.0, 0.0) ? shad_coord2.xy < float2(1.0, 1.0) ? 1.0 : 0.0;
	//sm_k.w = shad_coord3.xy > float2(0.0, 0.0) ? shad_coord3.xy < float2(1.0, 1.0) ? 1.0 : 0.0;

	//float4x4 sh_m = sm_k.x*PSSMProjTexMatrix0 +
	//				sm_k.y*PSSMProjTexMatrix1 + 
	//				sm_k.z*PSSMProjTexMatrix2 + 
	//				sm_k.w*PSSMProjTexMatrix3;

	shad_coord = 
		sm_k.x*shad_coord0 + 
		sm_k.y*shad_coord1 + 
		sm_k.z*shad_coord2 + 
		sm_k.w*shad_coord3;

	//shad_coord = mul(sh_m, float4(world_coords.xyz, 1));

	shad_coord.xyz /= shad_coord.w;

	float2 sm_offs = sm_k.x*float2(0, 0.5) +
		sm_k.y*float2(0.5, 0.5) + 
		sm_k.z*float2(0, 0) + 
		sm_k.w*float2(0.5, 0);

	//float2 sm_scale = sm_k.x*0.8 + sm_k.y*0.6 + sm_k.z*0.4 + sm_k.w*0.2;

	

	shadow_sample = tex2D(ShadowMap, float2(sm_offs.x + 0.5*shad_coord.x, sm_offs.y + 0.5*shad_coord.y));

	float shadow_factor = 1.0;

#ifndef COMPAREZ  
	shadow_factor = shadow_sample.r;   // 0 or 1
#else  //COMPAREZ
	shadow_factor = (shad_coord.z > shadow_sample.r + 0.0) ? 0 : 1;
	shadow_factor = shadow_sample.r > 0 ? shadow_factor : 1;
#endif //COMPAREZ
	
	//return sm_scale*shadow_factor;
	return shadow_factor; /// + sm_k_none;
}


float getShadowFactor(float ref_depth, float4 sm_sample)
{
	float shadow_factor = 1.0;

#ifndef COMPAREZ  
	shadow_factor = sm_sample.r;   // 0 or 1
#else  //COMPAREZ
	shadow_factor = (ref_depth > sm_sample.r) ? 0 : 1;
	shadow_factor = sm_sample.r > 0 ? shadow_factor : 1;
#endif //COMPAREZ

	return shadow_factor;
}


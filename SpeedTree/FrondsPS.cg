#ifdef SHADER_TEST
#include "defines.cg"
#endif

#define IDV_OPENGL


//-----------------------------------------------------------------------------
//	global parameters
//-----------------------------------------------------------------------------

// lighting & materials
uniform float3      g_vLightDiffuse;                    // light's diffuse color
uniform float3      g_vLightAmbient;                    // light's diffuse color
uniform float       g_fDiffuseScale;                    // mirrors the diffuse scalar value in CAD, used to help combat the darkening effect of multiple texture layers
//uniform float4      g_vMaterialDiffuse;                 // active material's diffuse color (set differently for branches, fronds, leaves, and billboards)
//uniform float4      g_vMaterialAmbient;                 // active material's ambient color (set differently for branches, fronds, leaves, and billboards)
//uniform float       g_fAmbientScale;                    // mirrors the ambient scalar value in CAD, used to help combat the darkening effect of multiple texture layers


//-----------------------------------------------------------------------------
//	SFrondOutput
//-----------------------------------------------------------------------------

struct SFrondOutput
{
	//float4 vPosition            : POSITION;
#ifdef INTERMEDIATE_FRONDBRANCH_FADING
	float3 vDiffuseTexCoords    : TEXCOORD0;    // .z = lod fade hint
#else // !INTERMEDIATE_FRONDBRANCH_FADING
	float3 vDiffuseTexCoords    : TEXCOORD0;
#endif // INTERMEDIATE_FRONDBRANCH_FADING

#ifdef SELF_SHADOW_LAYER
	float2 vSelfShadowTexCoords : TEXCOORD1;
#endif // SELF_SHADOW_LAYER

#ifdef FROND_NORMAL_MAPPING	
	float3 vNormal			: TEXCOORD2;	
#else
	float4 vColor			: COLOR0;	
#endif

#ifdef USE_SHADOWS
	float4	vShadowMapTexCoords	: TEXCOORD3;
	#ifdef USE_FOG
		float3 FogData			: TEXCOORD4;
	#endif
#else
	#ifdef USE_FOG
		float3 FogData			: TEXCOORD3;
	#endif
#endif // USE_SHADOWS
};


//-----------------------------------------------------------------------------
//  FrondPS
//
//  Frond geometry pixel shader.  This shader can process up to two texture layers:
//      - diffuse composite leaf/frond map
//      - self-shadow map (greyscale composite map generated via SpeedTreeCAD)
//-----------------------------------------------------------------------------

float4
main(SFrondOutput In 
	, uniform sampler2D samCompositeDiffuseLeafMap : TEXUNIT0 
	, uniform sampler2D samCompositeNormalLeafMap : TEXUNIT1 
	, uniform sampler2D samSelfShadowMap : TEXUNIT2 
#ifdef USE_SHADOWS
      , uniform sampler2D samShadowMap		: TEXUNIT3
	  #ifdef USE_FOG
		, uniform sampler2D FogMap			: TEXUNIT4 
	  #endif // USE_FOG
#else
	  #ifdef USE_FOG
		, uniform sampler2D FogMap			: TEXUNIT3 
	  #endif // USE_FOG
#endif // USE_SHADOWS
	 ) : COLOR
{
	
	float2 dsdx = float2(0, 0);
	float2 dsdy = float2(0, 0);

#ifdef FROND_NORMAL_MAPPING
    // since the normal map normal values (normally ranged [-1,1]) are stored
    // as a color value (ranged [0,1]), they must be uncompressed.  a dot product 
    // is used to compute the diffuse lighting contribution.
    float4 texNormal =
		tex2D(samCompositeNormalLeafMap, 		
		float2(In.vDiffuseTexCoords.x, 1.0 - In.vDiffuseTexCoords.y)); // ,
		// dsdx, dsdy);

    const float3 vHalves = { 0.5f, 0.5f, 0.5f };
    float fDot = saturate(dot(2.0f * (texNormal.rgb - vHalves), In.vNormal.rgb));
#endif
    
    // look up the diffuse layer
    float4 texDiffuse = tex2D(samCompositeDiffuseLeafMap, 
		float2(In.vDiffuseTexCoords.x, 1.0 - In.vDiffuseTexCoords.y)); // ,
		//dsdx, dsdy);
    
    // compute the ambient contribution (pulled from the diffuse map)
    float3 vAmbient = texDiffuse.xyz * g_vLightAmbient.xyz;

    // compute the full lighting equation, including diffuse and ambient values and
    // their respective scales.
#ifdef FROND_NORMAL_MAPPING
    float3 vColor3 = texDiffuse.rgb * fDot  * g_vLightDiffuse.rgb * g_fDiffuseScale;
#else
    float3 vColor3 = In.vColor.rgb * texDiffuse.rgb * g_fDiffuseScale;
#endif
 
// get shadowing factor
#ifdef USE_SHADOWS
	float4 shadow_map = tex2Dproj(samShadowMap, In.vShadowMapTexCoords.xyzw);
	#ifndef COMPAREZ
		float shadow_factor = shadow_map.b;   //0 or 1
	#else
		float zProj = In.vShadowMapTexCoords.z/In.vShadowMapTexCoords.w; 
		float shadow_factor = (zProj > shadow_map.b) ? 0 : 1;
	#endif // COMPAREZ
	vColor3.rgb *= shadow_factor;
#endif // USE_SHADOWS

#ifdef SELF_SHADOW_LAYER
    // overlay the shadow if active
    float4 texShadow = tex2D(samSelfShadowMap, 
		float2(In.vSelfShadowTexCoords.x, 1.0 - In.vSelfShadowTexCoords.y));
    vColor3 *= texShadow.xyz;
#endif    

    // compute the full lighting value
    float4 vColor = float4(vColor3 + vAmbient, texDiffuse.a);
    
#ifdef INTERMEDIATE_FRONDBRANCH_FADING
    float fFade = In.vDiffuseTexCoords.z;
    vColor.a *= fFade;
#endif
  
#ifdef USE_FOG
    float4 fogColor = tex2D(FogMap, In.FogData.xy);	
	vColor.rgb = lerp(vColor.rgb, fogColor.rgb, In.FogData.z);    
#endif

    return vColor;
}

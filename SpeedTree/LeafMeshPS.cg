#ifdef SHADER_TEST
#include "defines.cg"
#endif

#define IDV_OPENGL


//-----------------------------------------------------------------------------
//	global parameters
//-----------------------------------------------------------------------------

// lighting & materials
uniform float3      g_vLightDiffuse;                    // light's diffuse color
uniform float3      g_vLightAmbient;                    // light's ambient color
uniform float       g_fDiffuseScale;                    // mirrors the diffuse scalar value in CAD, used to help combat the darkening effect of multiple texture layers
// dont used
//uniform float       g_fAmbientScale;                    // mirrors the ambient scalar value in CAD, used to help combat the darkening effect of multiple texture layers
//uniform float3      g_vMaterialDiffuse;                 // active material's diffuse color (set differently for branches, fronds, leaves, and billboards)
//uniform float3      g_vMaterialAmbient;                 // active material's ambient color (set differently for branches, fronds, leaves, and billboards)


///////////////////////////////////////////////////////////////////////  
//  Leaf VS Ouput, PS Input

struct SLeafOutput
{
    float4 vPosition		: POSITION;
    float2 vBaseTexCoords	: TEXCOORD0;

#ifdef LEAF_NORMAL_MAPPING	
	float3 vNormal			: TEXCOORD1;
#else
    float4 vColor			: COLOR0;	
#endif

#ifdef USE_SHADOWS
	float4	vShadowMapTexCoords	 : TEXCOORD2;
	#ifdef USE_FOG
		float3 FogData		: TEXCOORD3;  // using FOG here causes a ps_2_0 compilation failure
	#endif
#else
	#ifdef USE_FOG
		float3 FogData		: TEXCOORD2;  // using FOG here causes a ps_2_0 compilation failure
	#endif
#endif
};


///////////////////////////////////////////////////////////////////////  
//  LeafPS
//
//  Leaf geometry pixel shader, shared by both leaf cards and mshes.  This 
//  shader processes only one layer:
//      - diffuse composite leaf/frond map
//
//  There is no self-shadow layer used in the leaf geometry.

float4 
main (SLeafOutput In
	  , uniform sampler2D samCompositeDiffuseLeafMap : TEXUNIT0 
	  , uniform sampler2D samCompositeNormalLeafMap : TEXUNIT1 	 
#ifdef USE_SHADOWS
      , uniform sampler2D samShadowMap   : TEXUNIT2
#endif // USE_SHADOWS
#ifdef USE_FOG
		, uniform sampler2D FogMap: TEXUNIT3 // Fog texture
#endif // USE_FOG
	  ) : COLOR
{
	float2 dsdx = float2(0, 0);
	float2 dsdy = float2(0, 0);
	
#ifdef LEAF_NORMAL_MAPPING
    // since the normal map normal values (normally ranged [-1,1]) are stored
    // as a color value (ranged [0,1]), they must be uncompressed.  a dot product 
    // is used to compute the diffuse lighting contribution.
    float4 texNormal = tex2D(samCompositeNormalLeafMap, 
		float2(In.vBaseTexCoords.x, 1.0f - In.vBaseTexCoords.y)); //dsdx, dsdy); 
    const float3 vHalves = { 0.5f, 0.5f, 0.5f };

    float fDot = saturate(dot(2.0f * (texNormal.rgb - vHalves), In.vNormal.rgb));
	//float fDot = 1.0; // saturate(dot(In.vNormal.rgb, In.vNormal.rgb));
	
#endif

    // look up the diffuse layer
    float4 texDiffuse =  tex2D(samCompositeDiffuseLeafMap, 
		float2(In.vBaseTexCoords.x, 1.0f - In.vBaseTexCoords.y)); 

    // compute the ambient contribution (pulled from the diffuse map)
    float3 vAmbient = g_vLightAmbient.rgb; //  * g_vMaterialAmbient.rgb * g_fAmbientScale * ;

    // compute the full lighting equation, including diffuse and ambient values and
    // their respective scales.
#ifdef LEAF_NORMAL_MAPPING
    float3 vDiffuse = g_fDiffuseScale * fDot * g_vLightDiffuse.rgb; // * g_vMaterialDiffuse.rgb;	
#else
    float3 vDiffuse = saturate(In.vColor.rgb * g_fDiffuseScale); // , In.vColor.a * texDiffuse.a);
#endif

	// get shadowing factor
#ifdef USE_SHADOWS
	float4 shadow_map = tex2Dproj(samShadowMap, In.vShadowMapTexCoords.xyzw);
	#ifndef COMPAREZ
		float shadow_factor = shadow_map.b;   // 0 or 1
	#else
		float zProj = In.vShadowMapTexCoords.z/In.vShadowMapTexCoords.w; 
		float shadow_factor = (zProj > shadow_map.b) ? 0 : 1;
	#endif // COMPAREZ
	vDiffuse *= shadow_factor;
#endif // USE_SHADOWS

	float4 vColor = float4(texDiffuse.rgb*(vDiffuse + vAmbient), texDiffuse.a);

#ifdef USE_FOG
    float4 fogColor = tex2D(FogMap, In.FogData.xy);	
	vColor.rgb = lerp(vColor.rgb, fogColor.rgb, In.FogData.z);    
#endif
	
    return vColor;
}



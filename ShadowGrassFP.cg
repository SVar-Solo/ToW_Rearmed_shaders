//****************************************************
//Fragment shader for support Shadow map in Grass 
//****************************************************

//#define FULL
//#define COMPAREZ  //used for Radeon
#define PSSM

struct VertexOut
{
//    float4 HPOS : POSITION;
	float4 COL0 : COLOR0;
	float4 COL1 : COLOR1;
    float2 TEX0 : TEXCOORD0;   //Vertical Grass
    float2 TEX1 : TEXCOORD1;   //Land
#ifdef FULL
    float4 TEX2 : TEXCOORD2;   //PSM
#endif
};

#ifdef FULL
	uniform sampler2D ShadowMap : TEXUNIT2;
#endif

#ifdef PSSM
// PSSM implemetation
// matrix array
uniform float4x4 PSSMProjTexMatrix0;
uniform float4x4 PSSMProjTexMatrix1;
uniform float4x4 PSSMProjTexMatrix2;
uniform float4x4 PSSMProjTexMatrix3;

uniform float PSSMSplit0;
uniform float PSSMSplit1;
uniform float PSSMSplit2;
uniform float PSSMSplit3;

uniform float PSSMWidth;

float getPSSMPixel3 (float4 world_coords)
{
    float4 shad_coord;
	float4 shadow_sample;

	// 0 level	
	float4 shad_coord0 = mul(PSSMProjTexMatrix0, float4(world_coords.xyz, 1));
	float4 shad_coord1 = mul(PSSMProjTexMatrix1, float4(world_coords.xyz, 1));
	float4 shad_coord2 = mul(PSSMProjTexMatrix2, float4(world_coords.xyz, 1));
	float4 shad_coord3 = mul(PSSMProjTexMatrix3, float4(world_coords.xyz, 1));

	float4 sm_k;
	
	if (shad_coord0.x > 0.0 && shad_coord0.x < 1.0 && shad_coord0.y > 0.0 && shad_coord0.y < 1.0)
	{
		sm_k.x = 1.0; // float4 (1.0, 0.0, 0.0, 0.0);
	}
	else
	{
		return 1;
		sm_k.x = 0.0;
		if (shad_coord1.x > 0.0 && shad_coord1.x < 1.0 && shad_coord1.y > 0.0 && shad_coord1.y < 1.0)
		{
			sm_k.y = 1.0;
		}
		else
		{
			sm_k.y = 0.0;
			if (shad_coord2.x > 0.0 && shad_coord2.x < 1.0 && shad_coord2.y > 0.0 && shad_coord2.y < 1.0)
			{
				sm_k.z = 1.0;
			}
			else
			{
				// sm_k.w = 1.0;
				if (shad_coord3.x > 0.0 && shad_coord3.x < 1.0 && shad_coord3.y > 0.0 && shad_coord3.y < 1.0)
				{
					sm_k.w = 1.0;
				}
				else
				{
					return 1;
				}
			}
		}
		
	}

	//float sm_k_none = 1 - (dot(sm_k, sm_k));
	
	shad_coord = 
		sm_k.x*shad_coord0 + 
		sm_k.y*shad_coord1 + 
		sm_k.z*shad_coord2 + 
		sm_k.w*shad_coord3;

	//shad_coord = mul(sh_m, float4(world_coords.xyz, 1));

	shad_coord.xyz /= shad_coord.w;

	float2 sm_offs = sm_k.x*float2(0, 0.5) +
		sm_k.y*float2(0.5, 0.5) + 
		sm_k.z*float2(0, 0) + 
		sm_k.w*float2(0.5, 0);

	float2 sm_scale = sm_k.x*0.8 + sm_k.y*0.6 + sm_k.z*0.4 + sm_k.w*0.2;

	shadow_sample = tex2D(ShadowMap, float2(sm_offs.x + 0.5*shad_coord.x, sm_offs.y + 0.5*shad_coord.y));

	float shadow_factor = 1.0;

#ifndef COMPAREZ  
	shadow_factor = shadow_sample.r;   // 0 or 1
#else  //COMPAREZ
	shadow_factor = (shad_coord.z > shadow_sample.r) ? 0 : 1;
	shadow_factor = shadow_sample.r > 0 ? shadow_factor : 1;
#endif //COMPAREZ
	
	//return sm_scale*shadow_factor;
	return shadow_factor; //  + sm_k_none;
}

#endif // PSSM




float4 main(VertexOut IN,
			uniform float4 Ka, //Ambient color
			uniform float4 Kd, //Diffuse color
            uniform sampler2D VGrassTex : TEXUNIT0,
            uniform sampler2D LandTex : TEXUNIT1
			) : COLOR
{

  float4 color;
  float4 diffuse_light;

//float4 Ka = float4(0.5, 0.5, 0.6, 0.0);    //???
//float4 Kd = float4(0.5, 0.5, 0.5, 0.0);    //???

  float4 tex0 = tex2D(VGrassTex, IN.TEX0.xy);
  float4 ColorStage0 = tex0 * IN.COL0;
  float4 tex1 = tex2D(LandTex, IN.TEX1.xy);  //0.5
  color.rgb = tex1.rgb * ColorStage0.rgb * 2.0f;   //*2.0 - ???
  color.a = ColorStage0.a;  //1.0;
  
  diffuse_light.rgb = tex1.a * (Kd.rgb+Ka.rgb);   

  //shadow vizualization 
#ifdef FULL
  float ShadowFactor = 0;

#ifdef PSSM
  ShadowFactor = getPSSMPixel3(IN.TEX2);

#else
  float4 Shadow = tex2Dproj(ShadowMap, IN.TEX2.xyzw);
#ifndef COMPAREZ  
	ShadowFactor = Shadow.r;   //0 or 1
#else  //COMPAREZ
	float zProj = IN.TEX2.z/IN.TEX2.w;
	ShadowFactor = (zProj > Shadow.r)?0:1;
	ShadowFactor = (Shadow.r>0)?ShadowFactor:1;
#endif //COMPAREZ
#endif PSSM

  diffuse_light.rgb = ShadowFactor * diffuse_light.rgb;
#endif //FULL

#ifdef PROFILE_FP20
	color.rgb = saturate(Ka.rgb + diffuse_light.rgb) * color.rgb;
#else
	color.rgb = clamp(Ka.rgb + diffuse_light.rgb, 0.0, 1.0) * color.rgb;
#endif

//--------------------------
/*
  //shadow
  float ShadowAtt = 0.75; //0.5; //0.6; //0.5;
  ShadowFactor = lerp(ShadowFactor,1.0,ShadowAtt);   //ShadowFactor = ShadowFactor*(1.0-ShadowAtt) + ShadowAtt;  
  color.rgb *= ShadowFactor;
*/

//--------------------------

  //fog (add secondary color)
  color.rgb += IN.COL1.rgb;  

  //color.rgb = tex1.aaa;
  //color.a = 1;
  //color.rgb = tex1.rgb*(tex1.a*Kd.rgb+Ka.rgb);
  //color = float4(1,1,1,1);
  return color;
}


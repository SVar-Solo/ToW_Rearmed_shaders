// From vertex shader
struct VertexOUT
{
	float2 texCoord : TEXCOORD0;
};

uniform sampler2D TexMap: TEXUNIT0; // Base texture

#define MAX_SAMPLES 16
uniform float2 avSampleOffsets[MAX_SAMPLES];

float4 main(in VertexOUT IN // From vertex shader
			) : COLOR
{
	float4 sample = vec4(0.0, 0.0, 0.0, 0.0);
	for(int i=0; i< MAX_SAMPLES; i++)
	{
		sample += tex2D(TexMap, IN.texCoord + avSampleOffsets[i]);
	}
	sample /= MAX_SAMPLES;
	return sample;
}


